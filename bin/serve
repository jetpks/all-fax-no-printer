#!/usr/bin/env ruby
# frozen_string_literal: true

# Production launcher — execs the supervised web topology in one host process.
# INGEST_TOKEN/INGEST_USER_ID pass through from the environment untouched: the
# token_user fallback in app/action.rb reads them per-request, so a directly-set
# INGEST_TOKEN is used as-is and per-user API tokens are preferred when one
# matches. (The former op://-ref resolution helper died with the I06 cut.)
#
# Usage: bin/serve

Dir.chdir(File.expand_path("..", __dir__))

exec("bundle", "exec", "falcon", "host", "falcon.rb")